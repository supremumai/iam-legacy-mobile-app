{
  "expo": {
    "name": "I Am Legacy",
    "slug": "iam-legacy-mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0900"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.legacyfusion.iamlegacy",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.legacyfusion.iamlegacy",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "scheme": "iam-legacy-mobile-app",
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-image-picker",
      "@react-native-community/datetimepicker",
      "expo-localization",
      "expo-video"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ec7f8060-aeef-4f0b-8744-adde75363a58"
      }
    },
    "owner": "legacito"
  }
}
